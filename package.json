{
  "name": "jarvis",
  "version": "1.0.0",
  "description": "J.A.R.V.I.S. - Just A Rather Very Intelligent System",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer && electron-builder",
    "build:main": "tsc -p tsconfig.main.json && tsc-alias -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json && tsc-alias -p tsconfig.preload.json",
    "build:renderer": "vite build",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "start": "electron dist/main/index.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "type": "module",
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/glob": "^8.1.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "electron": "^42.3.3",
    "electron-builder": "^24.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "tsc-alias": "^1.9.5",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "axios": "^1.7.0",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.0",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.0",
    "lucide-react": "^0.447.0",
    "postcss": "^8.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "tailwindcss": "^3.4.0",
    "zod": "^3.22.0"
  }
}
