{
  "productName": "JARVIS",
  "appId": "com.jarvis.ai",
  "artifactName": "${productName}-${version}.${ext}",
  "icon": "assets/icon.icns",
  "files": [
    "dist/main/**/*",
    "dist/preload/**/*",
    "dist/renderer/**/*",
    "dist/core/**/*",
    "node_modules/**/*"
  ],
  "directories": {
    "buildResources": "assets",
    "output": "dist"
  },
  "asar": true,
  "asarUnpack": [
    "node_modules/better-sqlite3/**/*"
  ],
  "extraResources": [
    {
      "from": "dist/preload",
      "to": "preload",
      "filter": "**/*"
    }
  ],
  "dmg": {
    "contents": [
      { "x": 130, "y": 220 },
      { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
    ]
  },
  "mac": {
    "target": ["dmg", "zip"],
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "entitlements": "entitlements.mac.plist",
    "entitlementsInherit": "entitlements.mac.plist",
    "sign": false,
    "identity": null
  },
  "linux": {
    "target": ["AppImage", "deb"]
  },
  "win": {
    "target": "NSIS",
    "icon": "build/icon.ico"
  }
}